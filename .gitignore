__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
~$*
*.tmp
*.bak
.lo-*/
.courseware-render.*/
.qa-render/
courseware/*.png
# Generated/source imagery is not shipped, EXCEPT lab output screenshots, which
# are build INPUTS referenced by a lab's verify_shot. git cannot re-include a
# file whose parent directory is excluded, so exclude the contents, not the dir.
courseware/assets/*
!courseware/assets/screenshots/
courseware/assets/screenshots/*
!courseware/assets/screenshots/*.png
.claude/
.codex/
reference/
courseware/archive/
labs/archive/

# Finder/iCloud/Drive duplicate-on-sync artefacts: "name 2.pdf", "name 3.docx".
# 126 of these once reached a commit in the Lab 1 invoice set.
* [0-9].*
*\ copy.*
*\ copy\ [0-9].*

# Learner output produced by running a lab — regenerated by the learner, never shipped.
labs/*/outputs/*
!labs/*/outputs/.gitkeep
labs/*/working/*
!labs/*/working/.gitkeep

# Playwright MCP session output (screenshot capture scratch).
.playwright-mcp/
